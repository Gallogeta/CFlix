# ===================================================
# CFlix Media Manager (CFMM) - Environment Configuration
# ===================================================
# Copy this file to .env or configure directly via the
# Web Settings tab at http://<your-server-ip>:8090/

PORT=8090
HOST=0.0.0.0

# Media Server (Jellyfin / Emby) Connection
# e.g., http://localhost:8096, http://192.168.1.50:8096, or https://jellyfin.example.com
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USER=
JELLYFIN_PASS=

# Host Storage Roots & Media Directories
MEDIA_ROOT=/media
MOVIES_DIR=/media/movies
SERIES_DIR=/media/tv
ANIME_DIR=/media/anime
ADULT_DIR=/media/adult

# Automated Watcher & Staging Directories
WATCH_DIR=/downloads
STAGING_DIR=/downloads/.staging
UPLOAD_TMP_DIR=/tmp/cfmm_uploads

# Background Auto-Watcher Settings
WATCHER_ENABLED=true
WATCHER_INTERVAL=10

# Optional Jellyfin Configuration Volume Path
JELLYFIN_CONFIG_DIR=/config
