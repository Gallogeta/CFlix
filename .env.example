# ==============================================================================
# CFlix Media Manager (CFMM) - Environment Configuration Template
# Perfect for Proxmox, CachyOS / Arch, and Direct Attached Storage (DAS) setups
# ==============================================================================

# --- Port & Host ---
PORT=8090
HOST=0.0.0.0

# --- Jellyfin Server Connection ---
# Can be local, LAN, or Tailscale IP (e.g. http://100.98.209.40:8096)
JELLYFIN_URL=http://100.98.209.40:8096
JELLYFIN_USER=admin
JELLYFIN_PASS=your_jellyfin_password

# --- Direct Attached Storage (DAS) / Media Root Paths ---
# If you have multiple drives in your DAS, list them comma-separated:
MEDIA_ROOTS=/mnt/das1,/mnt/das2
MEDIA_ROOT=/mnt/das1

# Primary library folders (CFMM will automatically auto-overflow to other DAS drives)
MOVIES_DIR=/mnt/das1/movies
SERIES_DIR=/mnt/das1/shows
ANIME_DIR=/mnt/das1/anime
ADULT_DIR=/mnt/das1/adult

# Path inside Jellyfin if running in container/different mount (defaults to /media)
JELLYFIN_MEDIA_PATH=/media

# --- Automated Ingestion & Watch Folder ---
# Monitored directory for completed downloads (can be local on DAS or an SMB/NFS mount from your personal PC)
WATCH_DIR=/mnt/das1/incoming
STAGING_DIR=/mnt/das1/.staging
UPLOAD_TMP_DIR=/mnt/das1/.tmp_uploads

WATCHER_ENABLED=true
WATCHER_INTERVAL=10
AUTO_OVERFLOW_ENABLED=true
AUTO_OVERFLOW_MIN_GB=50
STORAGE_ALLOCATION_STRATEGY=most_free_space
